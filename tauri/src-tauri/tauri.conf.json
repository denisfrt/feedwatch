{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "feedwatch",
    "version": "0.1.0",
    "identifier": "com.feedwatch.dev",
    "build": {
        "frontendDist": "../../frontend/dist",
        "devUrl": "http://localhost:3000",
        "beforeDevCommand": "pnpm run --filter frontend dev",
        "beforeBuildCommand": "pnpm run --filter backend build && pnpm run --filter frontend build"
    },
    "app": {
        "windows": [
            {
                "title": "feedwatch",
                "width": 800,
                "height": 600,
                "maximized": true,
                "resizable": true,
                "fullscreen": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "plugins": {
        "shell": {
            "open": true
        }
    },
    "bundle": {
        "active": true,
        "targets": "appimage",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "linux": {
            "appimage": {
                "bundleMediaFramework": false,
                "files": {}
            }
        },
        "externalBin": [
            "../../backend/dist/express-backend"
        ],
        "resources": {
            "../../backend/.env.production": "",
            "../../backend/node_modules/better-sqlite3/": "node_modules/better-sqlite3/",
            "../../backend/assets/schema.sql": "assets/schema.sql"
        }
    }
}