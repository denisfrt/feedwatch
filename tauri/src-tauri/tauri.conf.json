{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "feedwatch",
    "version": "0.2.0",
    "identifier": "com.feedwatch",
    "build": {
        "frontendDist": "../../frontend/dist",
        "devUrl": "http://localhost:3000",
        "beforeDevCommand": "pnpm run --filter frontend dev",
        "beforeBuildCommand": "pnpm run --filter backend build && pnpm run --filter frontend build"
    },
    "app": {
        "windows": [
            {
                "title": "feedwatch",
                "width": 800,
                "height": 600,
                "maximized": true,
                "resizable": true,
                "fullscreen": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "plugins": {
        "shell": {
            "open": true
        }
    }
}